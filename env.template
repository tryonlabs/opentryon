# OpenTryOn Environment Configuration Template
# Copy this file to .env and fill in your API keys
# cp env.template .env

# ========================================
# Virtual Try-On Services
# ========================================

# Amazon Nova Canvas (AWS Bedrock)
# Get credentials from: https://console.aws.amazon.com/bedrock/
# Required for: virtual_tryon_nova
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AMAZON_NOVA_REGION=us-east-1
AMAZON_NOVA_MODEL_ID=amazon.nova-canvas-v1:0

# Kling AI (Kolors Virtual Try-On + Kling 3.0 / 3.0 Omni / 2.5 Turbo video)
# Get API keys from: https://klingai.com/  (Open Platform)
# Docs: https://kling.ai/document-api/guides/get-started/overview
# Required for: vton kling-ai, video-generate kling-v3 / kling-v3-omni / kling-v2-5-turbo
KLING_AI_API_KEY=your_kling_api_key_here
KLING_AI_SECRET_KEY=your_kling_secret_key_here
KLING_AI_BASE_URL=https://api-singapore.klingai.com

# Segmind Try-On Diffusion
# Get API key from: https://www.segmind.com/
# Required for: virtual_tryon_segmind
SEGMIND_API_KEY=your_segmind_api_key_here

# Pruna AI (image generate/edit/upscale, multi-garment try-on, video)
# Get API key from: https://dashboard.pruna.ai/login (contact Pruna to get access)
# Required for: p-image, p-image-edit, p-image-upscale, p-image-tryon, p-video, p-video-replace, p-video-avatar, p-video-animate
PRUNA_API_KEY=your_pruna_api_key_here
# PRUNA_BASE_URL=https://api.pruna.ai  # Optional override

# FASHN AI Virtual Try-On (tryon-max / tryon-v1.6)
# Get API key from: https://app.fashn.ai/api
# Required for: opentryon vton --model fashn-tryon-max / fashn-tryon-v1.6
FASHN_API_KEY=your_fashn_api_key_here
# FASHN_BASE_URL=https://api.fashn.ai  # Optional override

# ========================================
# Image Generation Services
# ========================================

# Google Gemini (Nano Banana / Veo / Gemini Omni Flash)
# Get API key from: https://aistudio.google.com/app/apikey
# Required for: generate_image_nano_banana, generate_image_nano_banana_pro,
#   generate_image_nano_banana_2, generate_image_nano_banana_2_lite,
#   opentryon video-generate --model veo / gemini-omni
# Nano Banana 2 Lite (gemini-3.1-flash-lite-image) also powers
# `opentryon vton --model nano-banana-2-lite` (multi-image composition-based try-on)
# Gemini Omni Flash (gemini-omni-flash-preview) powers conversational video
# generation/editing via the Interactions API
GEMINI_API_KEY=your_gemini_api_key_here

# Black Forest Labs (FLUX.2)
# Get API key from: https://docs.bfl.ml/
# Required for: generate_image_flux2_pro, generate_image_flux2_flex
BFL_API_KEY=your_bfl_api_key_here

# Luma AI (Photon & Ray)
# Get Dream Machine key: https://lumalabs.ai/dream-machine/api
# Get Agents API key (Ray 3.2): https://platform.lumalabs.ai/
# Required for: luma-image, luma-video, luma-ray-3.2
LUMA_AI_API_KEY=your_luma_api_key_here
# LUMA_AGENTS_API_KEY=your_luma_agents_api_key_here  # Preferred for Ray 3.2
# LUMA_AGENTS_BASE_URL=https://agents.lumalabs.ai/v1

# OpenAI (GPT Image / Sora)
# Get API key from: https://platform.openai.com/api-keys
# Required for: gpt-image, sora
OPENAI_API_KEY=your_openai_api_key_here

# BytePlus ModelArk (Seedance video / Seedream image)
# Get API key from: https://console.byteplus.com/ (ModelArk)
# Docs: https://docs.byteplus.com/en/docs/ModelArk/
# Required for: seedance, seedream
ARK_API_KEY=your_byteplus_ark_api_key_here
# BYTEPLUS_ARK_API_KEY=...  # Alias for ARK_API_KEY
# BYTEPLUS_ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# xAI Grok Imagine (image + video)
# Get API key from: https://console.x.ai/
# Required for: grok-imagine-image, grok-imagine-video
XAI_API_KEY=your_xai_api_key_here
# XAI_BASE_URL=https://api.x.ai/v1

# Ideogram 4.0
# Get API key from: https://developer.ideogram.ai/
# Required for: ideogram
IDEOGRAM_API_KEY=your_ideogram_api_key_here
# IDEOGRAM_BASE_URL=https://api.ideogram.ai

# ========================================
# Multimodal Understanding Services
# ========================================

# Moonshot AI (Kimi K2.6, K2.7 Code, and K3)
# Get API key from: https://platform.kimi.ai/console/api-keys
# Required for: opentryon understand --model kimi-k2.6 / kimi-k2.7-code / kimi-k3
# Text, image, and video understanding -- general-purpose, not fashion-specific.
MOONSHOT_API_KEY=your_moonshot_api_key_here
# KIMI_BASE_URL=https://api.moonshot.ai/v1  # Optional override

# ========================================
# Preprocessing Models
# ========================================

# U2Net Cloth Segmentation Checkpoint
# Download from: https://github.com/levindabhi/cloth-segmentation/tree/master
# Required for: segment_garment, extract_garment
# Example path: /path/to/cloth_segm_u2net_latest.pth
U2NET_CLOTH_SEG_CHECKPOINT_PATH=

# ========================================
# Optional: API Server Configuration
# ========================================

# API Server Port (default: 8000)
# API_SERVER_PORT=8000

# API Server Host (default: 0.0.0.0)
# API_SERVER_HOST=0.0.0.0

# Enable Debug Mode (default: False)
# DEBUG=False

# ========================================
# Notes
# ========================================

# Minimum Required Services (for basic functionality):
#   - At least ONE virtual try-on service (Nova Canvas, Kling AI, or Segmind)
#   - At least ONE image generation service (Gemini, FLUX.2, or Luma AI)

# Optional Services:
#   - Luma AI: For video generation and additional image generation
#   - U2Net: For local garment preprocessing (can use API-based preprocessing instead)

# Service Configuration Status:
#   ✓ Configured: API key is set and validated
#   ✗ Not configured: API key is missing or invalid
#   Run the MCP server to see current configuration status

# To use this template:
# 1. Copy this file: cp env.template .env
# 2. Fill in your API keys in the .env file
# 3. Never commit the .env file (it's in .gitignore)

